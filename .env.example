# ── LLM provider selection ────────────────────────────────────────────────────
# AI_PROVIDER selects the fallback provider: "azure" or "openai".
AI_PROVIDER=azure
AI_MODEL=gpt-4o-mini
AI_JUDGE_MODEL=gpt-4o-mini
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0

# ── Groq (primary LLM) ────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key

# ── OpenAI (fallback when AI_PROVIDER=openai) ─────────────────────────────────
OPENAI_API_KEY=your-openai-api-key

# ── Azure OpenAI (fallback when AI_PROVIDER=azure) ────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ── Exa (job description fetch) ───────────────────────────────────────────────
EXA_API_KEY=your-exa-api-key

# ── Profile inputs (paths to your IC and Leadership profile text files) ───────
IC_PROFILE_PATH=./profiles/Profile-IC.txt
LEADERSHIP_PROFILE_PATH=./profiles/Profile-Leadership.txt

# ── Local vector store ────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db

# ── LangSmith tracing (optional) ──────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=job-application-agent

# ── Corporate proxy CA bundle (optional — only if behind a TLS-inspecting proxy)
# CORP_CA_BUNDLE=/absolute/path/to/corporate_ca_bundle.pem

# ── Candidate contact block for cover letters ─────────────────────────────────
CANDIDATE_NAME=Your Name
CANDIDATE_LOCATION=City, ZIP
CANDIDATE_PHONE=+00 00000 00000
CANDIDATE_EMAIL=you@example.com
CANDIDATE_LINKEDIN=https://www.linkedin.com/in/your-handle
